# PostgreSQL connection string used by Drizzle
DATABASE_URL="postgresql://user:password@localhost:5432/cuzion"

# Used only by src/lib/db/seed.ts to create the single v1 admin account.
# The password is hashed with bcrypt before being stored.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Secret used to sign session JWTs (lib/auth/session.ts). Generate a long
# random string for production, e.g. `openssl rand -base64 32`.
SESSION_SECRET="replace-with-a-long-random-string"
